    {
      "name": "00 - Authentication & CSRF Setup",
      "item": [
        {
          "name": "1. GET CSRF Token (Pre-Login)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test(\"CSRF token received\", function () {",
                  "    pm.expect(json.token).to.be.a('string');",
                  "    pm.collectionVariables.set(\"csrfToken\", json.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/csrf",
              "host": ["{{baseUrl}}"],
              "path": ["api", "csrf"]
            },
            "description": "Fetch CSRF token prior to authentication for form login submission."
          }
        },
        {
          "name": "2. POST Login (as ADMIN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Login successful (200 or 302 redirect)\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 302]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "email",
                  "value": "{{adminEmail}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{adminPassword}}",
                  "type": "text"
                },
                {
                  "key": "_csrf",
                  "value": "{{csrfToken}}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": ["{{baseUrl}}"],
              "path": ["login"]
            },
            "description": "Authenticate as ADMIN. Postman cookie jar automatically stores the JSESSIONID cookie."
          }
        },
        {
          "name": "3. GET CSRF Token (Post-Login / Refresh)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test(\"Updated CSRF token captured\", function () {",
                  "    pm.expect(json.token).to.be.a('string').and.not.empty;",
                  "    pm.collectionVariables.set(\"csrfToken\", json.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/csrf",
              "host": ["{{baseUrl}}"],
              "path": ["api", "csrf"]
            },
            "description": "After authentication Spring Security refreshes the CSRF token. Re-fetch it to authorize subsequent write operations."
          }
        }
      ]
    },
