          "name": "16. PATCH JSON Patch - Replace Title & Price (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test(\"Patched fields match\", function () {",
                  "    pm.expect(json.movieTitle).to.eql(\"Interstellar (IMAX Remastered)\");",
                  "    pm.expect(json.ticketPrice).to.eql(275.50);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json-patch+json"
              },
              {
                "key": "X-CSRF-TOKEN",
                "value": "{{csrfToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\"op\": \"replace\", \"path\": \"/movieTitle\", \"value\": \"Interstellar (IMAX Remastered)\"},\n  {\"op\": \"replace\", \"path\": \"/ticketPrice\", \"value\": 275.50}\n]"
