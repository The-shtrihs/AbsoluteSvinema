      "name": "02 - Screening CRUD (ADMIN)",
      "item": [
        {
          "name": "12. POST Create Screening (201 Created)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Location header is returned\", function () {",
                  "    pm.response.to.have.header(\"Location\");",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test(\"Created screening has ID\", function () {",
                  "    pm.expect(json.id).to.be.a('number');",
                  "    pm.expect(json.movieTitle).to.eql(\"Dune: Part Two\");",
